# Copiez ce fichier en .env pour un usage local (ne le commitez jamais).
# Sur GitHub, créez ces valeurs dans Settings → Secrets and variables → Actions.

# --- Intelligence artificielle (recherche web + extraction fiable) ---
# Gemini (gratuit) : créez une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (payant), si recherche_ia.fournisseur: claude
ANTHROPIC_API_KEY=

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vous@gmail.com
SMTP_PASSWORD=mot-de-passe-d-application
EMAIL_FROM=vous@gmail.com
EMAIL_TO=vous@gmail.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp ---
WHATSAPP_TO=+22670000000
# CallMeBot (gratuit) :
CALLMEBOT_APIKEY=
# ou Twilio (officiel) :
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
